#!/bin/sh
# Guard 1: refuse to commit a non-blank BARE_AI.md (prevents leaking live role data)
if ! git diff --cached --quiet -- BARE_AI.md; then
  if [ -s BARE_AI.md ]; then
    echo 'BLOCKED: BARE_AI.md must be blank when committed.'
    echo 'Live role data belongs in ~/.bare-ai/role.md (or ~/.gemini/BARE_AI.md), not in the repo.'
    exit 1
  fi
fi

# Guard 2: gitleaks secret scan on staged changes
if ! command -v gitleaks >/dev/null 2>&1; then
  echo 'gitleaks not found on PATH. Install it to enable secret scanning:'
  echo '  https://github.com/gitleaks/gitleaks'
  echo 'Emergency bypass: git commit --no-verify'
  exit 1
fi
gitleaks git --staged --redact --no-banner --verbose || {
  echo ''
  echo '===================================================='
  echo 'BLOCKED: gitleaks detected a secret in staged changes.'
  echo 'Remove the secret (or use a placeholder), then retry.'
  echo 'Emergency bypass: git commit --no-verify'
  echo '===================================================='
  exit 1
}

npm run pre-commit || {
  echo ''
  echo '===================================================='
  echo 'pre-commit checks failed. in case of emergency, run:'
  echo ''
  echo 'git commit --no-verify'
  echo '===================================================='
  exit 1
}
